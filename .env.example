# InvoiceRush environment variables
# Copy to .env.local for development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public domain used in emails and metadata
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
# Node environment: development | production | test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoicerush

# -----------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# Optional: set if Auth.js needs an explicit URL
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Mollie (subscription billing only — not for collecting end-customer invoice payments)
# -----------------------------------------------------------------------------
# Use test key in development: test_...
MOLLIE_API_KEY=test_replace_me
# Webhook base must be publicly reachable (use ngrok/cloudflared locally)
MOLLIE_WEBHOOK_URL=http://localhost:3000/api/billing/webhook
# Profile ID optional depending on account setup
# MOLLIE_PROFILE_ID=pfl_xxxxx

# -----------------------------------------------------------------------------
# Mollie Remote Payment server (WooCommerce client → this Vercel app)
# Separate from SaaS subscription billing above. Currency comes from each order.
# Client plugin server URL = NEXT_PUBLIC_APP_URL (e.g. https://your-app.vercel.app)
# -----------------------------------------------------------------------------
MOLLIE_REMOTE_API_KEY=live_or_test_your_key_here
MOLLIE_REMOTE_SHARED_SECRET=same-secret-as-client-plugin
# Optional: only accept this currency (leave unset to accept any client currency)
# MOLLIE_REMOTE_CURRENCY=GBP
# Optional Mollie description overrides (default: Order #{order_number})
# MOLLIE_REMOTE_DESCRIPTION_FORMAT=Order #{order_number}
# MOLLIE_REMOTE_DEFAULT_DESCRIPTION=Online Order

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_replace_me
EMAIL_FROM="InvoiceRush <noreply@dmrush.store>"
# Inbox that receives contact-form notifications
SUPPORT_INBOX=support@dmrush.store

# -----------------------------------------------------------------------------
# S3-compatible object storage (logos, PDFs, exports)
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=eu-west-2
S3_BUCKET=invoicerush-dev
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
# Optional custom public base URL / CDN
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# -----------------------------------------------------------------------------
# Background jobs
# -----------------------------------------------------------------------------
# Shared secret for cron / job endpoints
CRON_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Rate limiting / security
# -----------------------------------------------------------------------------
# Optional Upstash Redis for distributed rate limits (falls back to in-memory)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Monitoring (optional — leave unset until configured)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Analytics (optional — do not enable cookies until configured)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# Admin bootstrap (local/dev only — change immediately in production)
# -----------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@dmrush.store
ADMIN_BOOTSTRAP_PASSWORD=change-me-in-production
